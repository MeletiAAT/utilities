{
  "name": "@meleti/secrets",
  "version": "0.0.1",
  "description": "Owns typed secrets read from the environment or from the file system.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meleti/utilities.git",
    "directory": "packages/secrets"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@utilities/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "nx": {
    "sourceRoot": "packages/secrets/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/secrets/dist",
          "main": "packages/secrets/src/index.ts",
          "tsConfig": "packages/secrets/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.18"
  }
}
