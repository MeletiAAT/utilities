# Packages published under this scope live in the GitHub Packages npm registry.
# Credentials are intentionally not committed: pnpm/npm ignore auth tokens from
# a project-level .npmrc. Provide one of these instead:
#
#   npm:  npm config set "//npm.pkg.github.com/:_authToken" <PAT with read:packages>
#   pnpm: pnpm config set "//npm.pkg.github.com/:_authToken" <PAT with read:packages>
#   CI:   actions/setup-node writes its own user-level .npmrc from NODE_AUTH_TOKEN
@meleti:registry=https://npm.pkg.github.com
